# ===== 服务端口 =====
PORT=3000

# ===== MySQL 配置 =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123456
MYSQL_DATABASE=ai_knowledge

# ===== Redis 配置 =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 安全配置 =====
# 会话过期时间（秒），默认 7 天
SESSION_TTL=604800
# bcrypt 计算成本，越大越慢越安全（建议 10~12）
BCRYPT_ROUNDS=10
# 登录失败限流：窗口时间内允许的最大失败次数
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SEC=900
