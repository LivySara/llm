# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-XXXX
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL=deepseek-chat

# 同时连接多个 MCP server（逗号分隔的 .py 绝对路径）。
# 也可只填 SERVER_PATH 作为单 server 兼容配置。
SERVER_PATHS=../../../mcp/universal-studios-price/server.py,../../../mcp/universal-studios-guide/server.py
# SERVER_PATH=../../../mcp/universal-studios-price/server.py

# 启动 MCP server 子进程时使用的命令（Windows 上通常是 python，Linux/macOS 可能是 python3）
SERVER_COMMAND=python

# 跨会话持久化记忆文件路径
MEMORY_FILE=memory_store.json
